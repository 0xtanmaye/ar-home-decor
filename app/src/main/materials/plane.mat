// Semi-transparent overlay with a metric grid for detected floors and walls.
material {
    name : Plane,
    parameters : [
        {
            type : float4,
            name : color
        },
        {
            type : float,
            name : gridSpacing
        },
        {
            // ARCore depth image in metres (0 = no measurement).
            type : sampler2d,
            name : depthTexture,
            precision : high
        },
        {
            // 1 to check each pixel against the depth image, 0 to draw unchecked.
            type : float,
            name : depthEnabled
        },
        {
            // Inside ARCore's detected outline the plane is known to exist (ARCore tracked points
            // on it), so depth only decides whether something covers it: readings behind it are
            // reflections (glossy floors and table tops) or noise, and the orientation estimate
            // is too noisy to overrule ARCore. In the margin drawn beyond the outline (uv1.y > 0)
            // the surface was only assumed to continue, so depth must also confirm it is there:
            // not behind, and facing the same way. 1 applies that full check everywhere, for
            // outlines that are not ARCore's (walls marked by hand).
            type : float,
            name : fullCheckInside
        },
        {
            // Distance from the plane (metres) within which the real surface still counts as
            // the plane itself, before allowing for depth noise. Larger for walls: plain walls
            // give poor depth, and skirting boards and switches shouldn't cut them.
            type : float,
            name : baseTolerance
        },
        {
            // 1 for raised surfaces: inside ARCore's outline, where measured depth hasn't
            // confirmed the surface yet, hide it where this frame's depth sees clearly behind it
            // (ARCore merges a desk and a lower cabinet into one outline that spans the gap).
            // 0 for floors and ceilings: below a floor there are only reflections.
            type : float,
            name : checkBehindInside
        },
        {
            // Cosine of the largest angle between the real surface (from depth) and the plane
            // at which they still count as the same surface; 0 turns the check off. Stops a
            // surface that merely passes through the plane, such as a wall at table height,
            // from counting as the plane.
            type : float,
            name : minNormalAgreement
        },
        {
            // 1 to colour each pixel by the depth check instead of drawing the grid
            // (development aid): green = on the plane, red = in front of it, blue = behind it,
            // yellow = at the plane's distance but facing another way, grey = margin not (yet)
            // confirmed by measured depth, magenta = repeatedly seen through, white line = edge
            // of ARCore's own outline.
            type : float,
            name : debugView
        },
        {
            // Affine map from screen NDC (x, y, 1) to depth-image UV...
            type : float3,
            name : uvFromNdcU
        },
        {
            type : float3,
            name : uvFromNdcV
        },
        {
            // ...and back, from (u, v, 1) to NDC.
            type : float3,
            name : ndcFromUvX
        },
        {
            type : float3,
            name : ndcFromUvY
        },
        {
            // The camera projection's (P[0][0], P[1][1], P[2][0], P[2][1]): turns NDC into a
            // view-space ray.
            type : float4,
            name : projectionScaleOffset
        },
        {
            // What measured depth has shown over time about where the surface really is, in
            // world (x, z): 0.5 = no clear evidence, 1 = confirmed, 0 = seen through (see
            // SurfaceCoverage). With coverageEnabled = 1 it takes over from the per-frame check,
            // which on plain or glossy surfaces trusts filled-in depth (see material()).
            type : sampler2d,
            name : coverageTexture
        },
        {
            type : float,
            name : coverageEnabled
        },
        {
            // Affine map from grid coordinates (uv0, world (x, z) on floors and raised surfaces)
            // to coverage texture coordinates, as rows applied to (u, v, 1).
            type : float3,
            name : coverageFromGridU
        },
        {
            type : float3,
            name : coverageFromGridV
        }
    ],
    requires : [
        uv0,
        uv1
    ],
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    depthWrite : false,
    // uv0 is the grid position in metres, fixed in the world (see gridFromPlaneLocal in
    // PlaneRenderer.kt); keep it as-is.
    flipUV : false
}

fragment {
    // Depth error, per metre of distance, assumed when deciding whether the real surface is on
    // a plane.
    #define DEPTH_NOISE_PER_METRE 0.02

    // The real surface's orientation is measured between depth pixels this far apart on each
    // side of the one under the fragment: wide enough to average out ripples in the depth of
    // glossy or cluttered surfaces, narrow enough to keep edges.
    #define NORMAL_SPAN_PIXELS 3.0

    // Width of the fade below minNormalAgreement, as a cosine.
    #define NORMAL_FADE 0.1

    // A neighbouring depth sample whose depth differs from the centre's by more than this
    // fraction lies across an edge, on another surface (NORMAL_OUTLIER_RATIO in DepthNormals.kt;
    // the rule ARCore Depth Lab's normal estimate uses).
    #define NORMAL_OUTLIER_RATIO 0.2

    // View-space position of the real surface at depth-image coordinate uv.
    highp vec3 realPointAt(highp vec2 uv) {
        highp float depth = textureLod(materialParams_depthTexture, uv, 0.0).r;
        highp vec3 uvw = vec3(uv, 1.0);
        highp vec2 ndc = vec2(dot(materialParams.ndcFromUvX, uvw), dot(materialParams.ndcFromUvY, uvw));
        highp vec4 p = materialParams.projectionScaleOffset;
        // Depth images hold distance along the camera axis (-z in view space), so the point is
        // the ray with z = -1 scaled by the depth.
        return vec3((ndc.x + p.z) / p.x, (ndc.y + p.w) / p.y, -1.0) * depth;
    }

    // The real surface's direction through centre, from the samples before and after it along
    // one image axis. A sample across an edge (or without depth) is left out, and the one-sided
    // difference towards the other used, so that the estimate holds up to a surface's edge
    // instead of mixing in the surface beyond it. Zero if neither is on the same surface.
    highp vec3 tangentThrough(highp vec3 before, highp vec3 centre, highp vec3 after) {
        highp float limit = NORMAL_OUTLIER_RATIO * -centre.z;
        bool beforeOk = before.z < 0.0 && abs(before.z - centre.z) <= limit;
        bool afterOk = after.z < 0.0 && abs(after.z - centre.z) <= limit;
        if (beforeOk && afterOk) {
            return after - before;
        }
        if (afterOk) {
            return after - centre;
        }
        if (beforeOk) {
            return centre - before;
        }
        return vec3(0.0);
    }

    // |cos| of the angle between the real surface's normal at uv and the plane's normal, or 1
    // where it can't be estimated (then distance alone decides).
    highp float normalAgreement(highp vec2 uv, highp vec3 planeNormal) {
        highp vec2 span = NORMAL_SPAN_PIXELS / vec2(textureSize(materialParams_depthTexture, 0));
        highp vec3 centre = realPointAt(uv);
        highp vec3 alongU = tangentThrough(realPointAt(uv - vec2(span.x, 0.0)), centre, realPointAt(uv + vec2(span.x, 0.0)));
        highp vec3 alongV = tangentThrough(realPointAt(uv - vec2(0.0, span.y)), centre, realPointAt(uv + vec2(0.0, span.y)));
        highp vec3 normal = cross(alongU, alongV);
        highp float length2 = dot(normal, normal);
        if (length2 < 1e-12) {
            return 1.0;
        }
        return abs(dot(normal, planeNormal)) * inversesqrt(length2);
    }

    // What this frame's depth image says about the real surface seen through this pixel.
    struct DepthCheck {
        // 0 where something clearly covers the plane (the real surface is in front of it).
        float uncovered;
        // 1 where the real surface is the plane: at its distance and facing the same way (not,
        // for example, a wall where it passes through a table's height).
        float onPlane;
        // 0 where the real surface is clearly behind the plane (seen past its edge).
        float notBehind;
        vec3 debugColor;
    };

    DepthCheck checkDepth() {
        DepthCheck result = DepthCheck(1.0, 1.0, 1.0, vec3(0.0, 1.0, 0.0));
        highp vec3 viewPosition = (getViewFromWorldMatrix() * vec4(getWorldPosition(), 1.0)).xyz;
        // The plane's normal from how the position changes across the screen (exact for a
        // flat polygon). Screen-space derivatives must be taken before any branching.
        highp vec3 planeNormal = normalize(cross(dFdx(viewPosition), dFdy(viewPosition)));
        highp vec3 ndc = vec3(getNormalizedViewportCoord().xy * 2.0 - 1.0, 1.0);
        highp vec2 depthUv = vec2(dot(materialParams.uvFromNdcU, ndc), dot(materialParams.uvFromNdcV, ndc));
        highp float realDepth = textureLod(materialParams_depthTexture, depthUv, 0.0).r;
        if (realDepth <= 0.0) {
            return result;
        }
        highp float planeDepth = -viewPosition.z;
        // The camera's distance to the plane along its normal.
        highp float cameraToPlane = abs(dot(viewPosition, planeNormal));
        // The real point lies on the same ray at realDepth / planeDepth of the plane point's
        // distance, so its distance from the plane shrinks in the same proportion. Positive is
        // in front of the plane (towards the camera).
        highp float offset = (1.0 - realDepth / planeDepth) * cameraToPlane;
        // Depth noise grows with distance and lies along the ray; only its component along the
        // normal moves the point off the plane (little of it when the plane is seen edge-on).
        highp float alongNormal = cameraToPlane / length(viewPosition);
        highp float tolerance = materialParams.baseTolerance + DEPTH_NOISE_PER_METRE * planeDepth * alongNormal;

        highp float t = clamp(offset / (2.0 * tolerance), -1.0, 1.0);
        result.debugColor = vec3(max(t, 0.0), 1.0 - abs(t), max(-t, 0.0));
        result.uncovered = 1.0 - smoothstep(tolerance, 2.0 * tolerance, offset);
        result.notBehind = 1.0 - smoothstep(tolerance, 2.0 * tolerance, -offset);
        float atPlaneDistance = 1.0 - smoothstep(tolerance, 2.0 * tolerance, abs(offset));
        float facing = 1.0;
        if (atPlaneDistance > 0.0 && materialParams.minNormalAgreement > 0.0) {
            facing = smoothstep(
                materialParams.minNormalAgreement - NORMAL_FADE,
                materialParams.minNormalAgreement,
                normalAgreement(depthUv, planeNormal));
            result.debugColor = mix(vec3(1.0, 1.0, 0.0), result.debugColor, facing);
        }
        result.onPlane = atPlaneDistance * facing;
        return result;
    }

    // Coverage map values (see coverageValue in SurfaceCoverage.kt): 0.5 = no clear evidence,
    // 0.625 / 0.75 / 0.875 / 1 = the surface was measured there in 1 / 2 / 3 / 4+ more frames
    // than it was seen through, 0 = refuted (seen through, hardly ever seen).
    #define CONFIRMED_FROM 0.6
    #define CONFIRMED_AT 0.85
    #define REFUTED_FROM 0.3
    #define REFUTED_AT 0.1

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // uv0 holds grid coordinates in metres, fixed in the world: draw a line every
        // gridSpacing metres.
        vec2 cell = getUV0() / materialParams.gridSpacing;
        vec2 distanceToLine = abs(fract(cell - 0.5) - 0.5) / fwidth(cell);
        float line = 1.0 - min(min(distanceToLine.x, distanceToLine.y), 1.0);

        vec4 color = materialParams.color;
        // uv1.x fades from 0 on the drawn outline to 1 a short distance inside it. uv1.y rises
        // from 0 on ARCore's outline across the margin drawn beyond it; the margin's rules
        // apply in full a few centimetres out.
        float edge = getUV1().x;
        float marginGradient = fwidth(getUV1().y);
        float margin = smoothstep(0.0, 0.1, getUV1().y);

        float visibility = 1.0;
        vec3 debugColor = vec3(0.0, 1.0, 0.0);
        if (materialParams.depthEnabled > 0.5) {
            DepthCheck depth = checkDepth();
            debugColor = depth.debugColor;
            if (materialParams.coverageEnabled > 0.5) {
                highp vec3 grid = vec3(getUV0(), 1.0);
                highp vec2 coverageUv = vec2(dot(materialParams.coverageFromGridU, grid), dot(materialParams.coverageFromGridV, grid));
                float coverage = texture(materialParams_coverageTexture, coverageUv).r;
                float confirmed = smoothstep(CONFIRMED_FROM, CONFIRMED_AT, coverage);
                float refuted = 1.0 - smoothstep(REFUTED_AT, REFUTED_FROM, coverage);
                // Inside ARCore's outline the surface is there unless measurements keep seeing
                // through it. Until measurements confirm a spot, a raised surface also yields to
                // this frame's depth seeing clearly behind it (see checkBehindInside); once
                // confirmed, reflections in a glossy top can't make it flicker. Orientation is
                // too noisy on such tops to be used here. Beyond the outline, only what
                // measurements have confirmed is drawn.
                float notBehind = mix(1.0, depth.notBehind, materialParams.checkBehindInside);
                float inside = (1.0 - refuted) * mix(notBehind, 1.0, confirmed);
                visibility = depth.uncovered * mix(inside, confirmed, margin);
                debugColor = mix(debugColor, vec3(1.0, 0.0, 1.0), refuted * (1.0 - margin));
                debugColor = mix(debugColor, vec3(0.25), (1.0 - confirmed) * margin);
            } else {
                // Without a coverage map: inside ARCore's outline only something in front hides
                // the plane; beyond it (and everywhere for outlines that are not ARCore's) this
                // frame's depth must confirm the surface.
                float strictness = max(materialParams.fullCheckInside, margin);
                visibility = mix(depth.uncovered, depth.onPlane, strictness);
            }
        }
        if (materialParams.debugView > 0.5) {
            // A white line just outside ARCore's own outline, where the margin starts.
            if (marginGradient > 0.0 && getUV1().y < 2.0 * marginGradient) {
                debugColor = vec3(1.0);
            }
            float debugAlpha = 0.6 * edge;
            material.baseColor = vec4(debugColor * debugAlpha, debugAlpha);
            return;
        }
        float alpha = mix(color.a, min(color.a * 3.0, 0.9), line) * edge * visibility;
        // Transparent blending in Filament expects premultiplied alpha.
        material.baseColor = vec4(color.rgb * alpha, alpha);
    }
}
