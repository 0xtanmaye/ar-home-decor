// Semi-transparent overlay with a metric grid for detected floors and walls.
material {
    name : Plane,
    parameters : [
        {
            type : float4,
            name : color
        },
        {
            type : float,
            name : gridSpacing
        },
        {
            // ARCore depth image in metres (0 = no measurement).
            type : sampler2d,
            name : depthTexture,
            precision : high
        },
        {
            // 1 to check each pixel against the depth image, 0 to draw unchecked.
            type : float,
            name : depthEnabled
        },
        {
            // 1 to also hide grid where the real surface is behind the plane (overhang past a
            // table edge). 0 for floors and ceilings: nothing real is behind them, so a farther
            // reading there is a reflection or noise.
            type : float,
            name : hideWhenFarther
        },
        {
            // Affine map from screen NDC (x, y, 1) to depth-image UV.
            type : float3,
            name : uvFromNdcU
        },
        {
            type : float3,
            name : uvFromNdcV
        }
    ],
    requires : [
        uv0,
        uv1
    ],
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    depthWrite : false,
    // uv0 is plane-local position in metres; keep it as-is.
    flipUV : false
}

fragment {
    // How well the real surface (from the depth image) agrees with this plane at this pixel:
    // 1 where they match, fading to 0 where the real surface is clearly nearer (something is in
    // front of the plane) or, if enabled, clearly farther (the plane overhangs a real edge).
    float depthAgreement() {
        highp vec3 ndc = vec3(getNormalizedViewportCoord().xy * 2.0 - 1.0, 1.0);
        highp vec2 depthUv = vec2(dot(materialParams.uvFromNdcU, ndc), dot(materialParams.uvFromNdcV, ndc));
        highp float realDepth = texture(materialParams_depthTexture, depthUv).r;
        if (realDepth <= 0.0) {
            return 1.0;
        }
        highp vec3 viewPosition = (getViewFromWorldMatrix() * vec4(getWorldPosition(), 1.0)).xyz;
        highp float planeDepth = -viewPosition.z;
        // Depth from a single moving camera gets less precise with distance.
        highp float tolerance = 0.05 + 0.04 * planeDepth;
        highp float behind = realDepth - planeDepth;
        if (behind < 0.0) {
            return 1.0 - smoothstep(tolerance, 2.0 * tolerance, -behind);
        }
        if (materialParams.hideWhenFarther < 0.5) {
            return 1.0;
        }
        // Overhangs are large (a table edge over the floor), so a looser test avoids hiding
        // grid because of depth noise.
        return 1.0 - smoothstep(2.0 * tolerance, 4.0 * tolerance, behind);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // uv0 holds plane-local coordinates in metres: draw a line every gridSpacing metres.
        vec2 cell = getUV0() / materialParams.gridSpacing;
        vec2 distanceToLine = abs(fract(cell - 0.5) - 0.5) / fwidth(cell);
        float line = 1.0 - min(min(distanceToLine.x, distanceToLine.y), 1.0);

        vec4 color = materialParams.color;
        // uv1.x fades from 0 on ARCore's outline to 1 a short distance inside it.
        float edge = getUV1().x;
        float visibility = materialParams.depthEnabled > 0.5 ? depthAgreement() : 1.0;
        float alpha = mix(color.a, min(color.a * 3.0, 0.9), line) * edge * visibility;
        // Transparent blending in Filament expects premultiplied alpha.
        material.baseColor = vec4(color.rgb * alpha, alpha);
    }
}
